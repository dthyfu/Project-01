# Neo4j: use the same local configuration as the existing HybridRAG setup.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_your_local_password
NEO4J_DATABASE=neo4j

# Local Ollama only; no cloud API is used.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.85
OLLAMA_REPEAT_PENALTY=1.15
OLLAMA_REPEAT_LAST_N=128
OLLAMA_NUM_PREDICT=96
# Direct type 1/type 2 comparisons use 128 tokens so both mechanisms can finish.

# Optional local conversation database path.
# CHAT_DATABASE=data/chat_history.sqlite3
